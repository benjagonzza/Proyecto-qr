<PantallaLogin>:
    name: 'login'
    MDBoxLayout:
        orientation: 'vertical'
        padding: "24dp"
        spacing: "16dp"

        Widget:

        MDLabel:
            text: "LabRedes A+S"
            font_style: "Headline"
            role: "large"
            bold: True
            halign: "center"
            theme_text_color: "Custom"
            text_color: 0.22, 0.74, 0.97, 1

        MDLabel:
            text: "Iniciar Sesión"
            font_style: "Title"
            role: "medium"
            halign: "center"

        MDTextField:
            id: txt_login_email
            hint_text: "Correo institucional"
            text: "admin@uct.cl"

        MDTextField:
            id: txt_login_pass
            hint_text: "Contraseña"
            password: True
            text: "123456"

        MDButton:
            style: "filled"
            size_hint_x: 1
            on_release: app.ejecutar_login(txt_login_email.text, txt_login_pass.text)
            MDButtonText:
                text: "INGRESAR"
                bold: True

        MDButton:
            style: "text"
            size_hint_x: 1
            on_release: app.cambiar_pantalla('registro')
            MDButtonText:
                text: "¿No tienes cuenta? Regístrate aquí"

        Widget:


<PantallaRegistro>:
    name: 'registro'
    MDBoxLayout:
        orientation: 'vertical'
        padding: "24dp"
        spacing: "12dp"

        MDLabel:
            text: "Registro de Usuario"
            font_style: "Headline"
            role: "small"
            bold: True
            halign: "center"

        MDTextField:
            id: txt_reg_email
            hint_text: "Correo electrónico"

        MDTextField:
            id: txt_reg_pass
            hint_text: "Contraseña"
            password: True

        MDTextField:
            id: txt_reg_confirm
            hint_text: "Confirmar contraseña"
            password: True

        MDButton:
            style: "filled"
            size_hint_x: 1
            on_release: app.registrar_usuario(txt_reg_email.text, txt_reg_pass.text, txt_reg_confirm.text)
            MDButtonText:
                text: "CREAR CUENTA"

        MDButton:
            style: "outlined"
            size_hint_x: 1
            on_release: app.cambiar_pantalla('login')
            MDButtonText:
                text: "VOLVER AL LOGIN"


<PantallaInicio>:
    name: 'inicio'
    MDBoxLayout:
        orientation: 'vertical'

        MDBoxLayout:
            orientation: 'vertical'
            padding: "16dp"
            spacing: "16dp"

            MDLabel:
                text: "Panel de Control"
                font_style: "Headline"
                role: "small"
                bold: True
                theme_text_color: "Custom"
                text_color: 0.22, 0.74, 0.97, 1

            MDCard:
                orientation: "vertical"
                padding: "12dp"
                size_hint_y: None
                height: "90dp"
                style: "elevated"
                md_bg_color: 0.12, 0.16, 0.23, 1

                MDLabel:
                    text: app.mensaje_banner
                    font_style: "Body"
                    role: "medium"
                    halign: "center"

                MDLabel:
                    text: app.contacto_soporte
                    font_style: "Body"
                    role: "small"
                    halign: "center"
                    theme_text_color: "Hint"

            MDBoxLayout:
                orientation: 'horizontal'
                spacing: "8dp"
                size_hint_y: None
                height: "90dp"

                MDCard:
                    padding: "8dp"
                    md_bg_color: 0.1, 0.3, 0.15, 1
                    MDBoxLayout:
                        orientation: 'vertical'
                        MDLabel:
                            id: lbl_disp
                            text: "0"
                            font_style: "Headline"
                            bold: True
                            halign: "center"
                        MDLabel:
                            text: "Disponibles"
                            halign: "center"

                MDCard:
                    padding: "8dp"
                    md_bg_color: 0.35, 0.25, 0.05, 1
                    MDBoxLayout:
                        orientation: 'vertical'
                        MDLabel:
                            id: lbl_prest
                            text: "0"
                            font_style: "Headline"
                            bold: True
                            halign: "center"
                        MDLabel:
                            text: "En Préstamo"
                            halign: "center"

                MDCard:
                    padding: "8dp"
                    md_bg_color: 0.35, 0.1, 0.1, 1
                    MDBoxLayout:
                        orientation: 'vertical'
                        MDLabel:
                            id: lbl_desu
                            text: "0"
                            font_style: "Headline"
                            bold: True
                            halign: "center"
                        MDLabel:
                            text: "En Desuso"
                            halign: "center"

            Widget:

        MDNavigationBar:
            MDNavigationItem:
                active: True
                on_release: app.cambiar_pantalla('inicio')
                MDNavigationItemIcon:
                    icon: "home"
                MDNavigationItemLabel:
                    text: "Inicio"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('catalogo')
                MDNavigationItemIcon:
                    icon: "format-list-bulleted"
                MDNavigationItemLabel:
                    text: "Catálogo"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('escaner')
                MDNavigationItemIcon:
                    icon: "qrcode-scan"
                MDNavigationItemLabel:
                    text: "Código QR"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('prestamos')
                MDNavigationItemIcon:
                    icon: "hand-holding"
                MDNavigationItemLabel:
                    text: "Préstamos"


<PantallaCatalogo>:
    name: 'catalogo'
    MDBoxLayout:
        orientation: 'vertical'
        padding: "12dp"
        spacing: "8dp"

        MDTextField:
            hint_text: "Buscar por nombre o código..."
            on_text: app.actualizar_catalogo(self.text)

        MDScrollView:
            MDList:
                id: lista_catalogo

        MDNavigationBar:
            MDNavigationItem:
                on_release: app.cambiar_pantalla('inicio')
                MDNavigationItemIcon:
                    icon: "home"
                MDNavigationItemLabel:
                    text: "Inicio"
            MDNavigationItem:
                active: True
                on_release: app.cambiar_pantalla('catalogo')
                MDNavigationItemIcon:
                    icon: "format-list-bulleted"
                MDNavigationItemLabel:
                    text: "Catálogo"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('escaner')
                MDNavigationItemIcon:
                    icon: "qrcode-scan"
                MDNavigationItemLabel:
                    text: "Código QR"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('prestamos')
                MDNavigationItemIcon:
                    icon: "hand-holding"
                MDNavigationItemLabel:
                    text: "Préstamos"


<PantallaEscaner>:
    name: 'escaner'
    MDBoxLayout:
        orientation: 'vertical'
        padding: "12dp"
        spacing: "8dp"

        MDLabel:
            id: lbl_qr_titulo
            text: "Seleccione un equipo"
            font_style: "Title"
            halign: "center"

        Image:
            id: qr_image_view
            size_hint_y: 0.4

        MDLabel:
            id: lbl_qr_codigo
            text: "Escanee el código QR desde el móvil"
            halign: "center"
            theme_text_color: "Hint"

        MDScrollView:
            MDList:
                id: lista_escaner

        MDNavigationBar:
            MDNavigationItem:
                on_release: app.cambiar_pantalla('inicio')
                MDNavigationItemIcon:
                    icon: "home"
                MDNavigationItemLabel:
                    text: "Inicio"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('catalogo')
                MDNavigationItemIcon:
                    icon: "format-list-bulleted"
                MDNavigationItemLabel:
                    text: "Catálogo"
            MDNavigationItem:
                active: True
                on_release: app.cambiar_pantalla('escaner')
                MDNavigationItemIcon:
                    icon: "qrcode-scan"
                MDNavigationItemLabel:
                    text: "Código QR"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('prestamos')
                MDNavigationItemIcon:
                    icon: "hand-holding"
                MDNavigationItemLabel:
                    text: "Préstamos"


<PantallaPrestamos>:
    name: 'prestamos'
    MDBoxLayout:
        orientation: 'vertical'
        padding: "12dp"

        MDLabel:
            text: "Equipos en Préstamo Activo"
            font_style: "Title"

        MDScrollView:
            MDList:
                id: lista_prestamos

        MDNavigationBar:
            MDNavigationItem:
                on_release: app.cambiar_pantalla('inicio')
                MDNavigationItemIcon:
                    icon: "home"
                MDNavigationItemLabel:
                    text: "Inicio"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('catalogo')
                MDNavigationItemIcon:
                    icon: "format-list-bulleted"
                MDNavigationItemLabel:
                    text: "Catálogo"
            MDNavigationItem:
                on_release: app.cambiar_pantalla('escaner')
                MDNavigationItemIcon:
                    icon: "qrcode-scan"
                MDNavigationItemLabel:
                    text: "Código QR"
            MDNavigationItem:
                active: True
                on_release: app.cambiar_pantalla('prestamos')
                MDNavigationItemIcon:
                    icon: "hand-holding"
                MDNavigationItemLabel:
                    text: "Préstamos"


MDScreenManager:
    id: screen_manager
    PantallaLogin:
    PantallaRegistro:
    PantallaInicio:
    PantallaCatalogo:
    PantallaEscaner:
    PantallaPrestamos: